{
  "manifest_version": 3,
  "name": "Vini",
  "version": "1.0",
  "description": "Voice-to-text on a hotkey. Talk, press again, paste anywhere. Uses ChatGPT's own dictation: no API key, no server.",
  "permissions": [
    "scripting",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vini",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Start / stop ChatGPT dictation (stop copies the text)",
      "global": true
    }
  },
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}